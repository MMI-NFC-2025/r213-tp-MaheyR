---
import Layout from "../../layouts/Layout.astro";
import { getAgents } from "../../backend.mjs";

const agents = await getAgents();
---

<Layout titre="Agents">
  <div style="max-width: 900px; margin: 0 auto; padding: 20px;">
    <h1 style="font-size: 28px; margin-bottom: 10px;">Liste des agents</h1>
    <a href="/" style="color: #0066cc; text-decoration: underline;">← Retour</a>

    <div style="margin-top: 30px;">
      {agents.map((agent) => (
        <div style="border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; background: #f9f9f9;">
          <h2 style="font-size: 20px; margin: 0 0 5px 0;">{agent.prenom} {agent.nom}</h2>
          <p style="color: #666; margin: 0 0 10px 0;">{agent.email}</p>
          <a
            href={`/agents/${agent.id}`}
            style="display: inline-block; background: #333; color: white; padding: 8px 16px; text-decoration: none;"
          >
            Voir ses offres
          </a>
        </div>
      ))}
    </div>
  </div>
</Layout>