---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getEvents } from "../../backend.mjs";

const events = await getEvents();
---

<Layout title="Agenda">
  <main class="p-6 space-y-6">
    <h1 class="text-3xl font-bold">Agenda</h1>
    <p class="text-gray-600">Liste des événements à venir</p>

    <div class="space-y-4">
      {events.length === 0 ? (
        <p class="text-gray-500">Aucun événement pour le moment.</p>
      ) : (
        events.map((event: any) => (
          <div class="border rounded-lg p-4 hover:shadow-md transition-shadow">
            <h2 class="text-xl font-semibold">{event.titre ?? event.title ?? "Événement"}</h2>
            {event.date && <p class="text-gray-600"><strong>Date :</strong> {event.dateFormatted ?? event.date}</p>}
            {event.lieu && <p class="text-gray-600"><strong>Lieu :</strong> {event.lieu}</p>}
            {event.description && <p class="mt-2">{event.description}</p>}
          </div>
        ))
      )}
    </div>

    <a class="inline-block mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" href="/">
      ← Retour à l'accueil
    </a>
  </main>
</Layout>
